RHFormalization.Harch_holomorphic_from_witness_and_regular
  (Y : RHFormalization.DDetailedConstructionWithOperatorLegality) (Zpole : ℂ → ℂ)
  (h_witness :
    ∀ (W : RHFormalization.ZeroWitness),
      ∃ h,
        RHFormalization.HolomorphicAtC h W.s0 ∧
          RHFormalization.LocalEqAtC h (fun s => Y.B.Cshared.Bshared s + Zpole s) W.s0)
  (h_regular :
    ∀ z ∈ Ω,
      (∀ (W : RHFormalization.ZeroWitness), z ≠ W.s0) →
        ∃ h,
          RHFormalization.HolomorphicAtC h z ∧
            RHFormalization.LocalEqAtC h (fun s => Y.B.Cshared.Bshared s + Zpole s) z) :
  RHFormalization.HolomorphicOnC (fun s => Y.B.Cshared.Bshared s + Zpole s) Ω
RHFormalization.Harch_local_extension_at_witness_from_cancelled_principal_parts
  (Y : RHFormalization.DDetailedConstructionWithOperatorLegality) (Zpole : ℂ → ℂ) (W : RHFormalization.ZeroWitness)
  (c : ℂ) (hB : RHFormalization.HasPrincipalPartAtC Y.B.Cshared.Bshared W.s0 c)
  (hZ : RHFormalization.HasPrincipalPartAtC Zpole W.s0 (-c))
  (hpoint :
    have hBreg := Classical.choose hB;
    have hZreg := Classical.choose hZ;
    hBreg W.s0 + hZreg W.s0 = Y.B.Cshared.Bshared W.s0 + Zpole W.s0) :
  ∃ h,
    RHFormalization.HolomorphicAtC h W.s0 ∧ RHFormalization.LocalEqAtC h (fun s => Y.B.Cshared.Bshared s + Zpole s) W.s0
