RHFormalization.BsharedOppositePrincipalPartData (Y : RHFormalization.DDetailedConstructionWithOperatorLegality)
  (M : RHFormalization.ZeroMultiplicityData) : Type
RHFormalization.Harch_witness_extensions_from_BsharedPrincipalPartData
  (Y : RHFormalization.DDetailedConstructionWithOperatorLegality) (Zpole : ℂ → ℂ)
  (M : RHFormalization.ZeroMultiplicityData) (BPP : RHFormalization.BsharedOppositePrincipalPartData Y M)
  (hZ :
    ∀ (W : RHFormalization.ZeroWitness),
      RHFormalization.HasPrincipalPartAtC Zpole W.s0 (- -RHFormalization.groupedResidueCoeff M (BPP.groupedClass W)))
  (hpoint :
    ∀ (W : RHFormalization.ZeroWitness),
      have c := -RHFormalization.groupedResidueCoeff M (BPP.groupedClass W);
      have hBreg := Classical.choose ⋯;
      have hZreg := Classical.choose ⋯;
      hBreg W.s0 + hZreg W.s0 = Y.B.Cshared.Bshared W.s0 + Zpole W.s0)
  (W : RHFormalization.ZeroWitness) :
  ∃ h,
    RHFormalization.HolomorphicAtC h W.s0 ∧ RHFormalization.LocalEqAtC h (fun s => Y.B.Cshared.Bshared s + Zpole s) W.s0
