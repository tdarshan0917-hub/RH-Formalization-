theorem RHFormalization.sharedBIdentity_of_Cshared_eq : ∀
  (Y : RHFormalization.DDetailedConstructionWithOperatorLegality) (X : RHFormalization.HMeromorphicWithNormalFormPoles),
  Y.B.Cshared = X.layer.overlap.Cshared →
    ∀ s ∈ RHFormalization.RightHalfPlane (RHFormalization.sharedCompatibilitySigma Y X),
      Y.B.Cshared.Bshared s = X.layer.overlap.Cshared.Bshared s :=
fun Y X hC s hs =>
  of_eq_true
    (Eq.trans
      (congrFun' (congrArg Eq (congrFun' (congrArg RHFormalization.CanonicalPrimePowerPackage.Bshared hC) s))
        (X.layer.overlap.Cshared.Bshared s))
      (eq_self (X.layer.overlap.Cshared.Bshared s)))
theorem RHFormalization.finalRHSpine_from_Cshared_eq : RHFormalization.ZetaZeroFacts →
  ∀ (Y : RHFormalization.DDetailedConstructionWithOperatorLegality)
    (X : RHFormalization.HMeromorphicWithNormalFormPoles),
    Y.B.Cshared = X.layer.overlap.Cshared → RHFormalization.RiemannHypothesis :=
fun ZF Y X hC =>
  RHFormalization.finalRHSpine_from_sharedBIdentity ZF Y X (RHFormalization.sharedBIdentity_of_Cshared_eq Y X hC)
