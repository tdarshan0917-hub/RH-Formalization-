def RHFormalization.PrimePowerPair.p : RHFormalization.PrimePowerPair → ℕ :=
fun q => q.1
def RHFormalization.PrimePowerPair.m : RHFormalization.PrimePowerPair → ℕ :=
fun q => q.2
def RHFormalization.PrimePowerPair.natValue : RHFormalization.PrimePowerPair → ℕ :=
fun q => q.p ^ q.m
def RHFormalization.IsPrimePowerPair : RHFormalization.PrimePowerPair → Prop :=
fun q => Nat.Prime q.p ∧ 0 < q.m
