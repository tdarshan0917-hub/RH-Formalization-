def RHFormalization.buildDDetailedConstructionWithOperatorLegalityFromFiniteCanonicalLimit : (finiteOperatorLayer :
    RHFormalization.DFiniteStagePackageFromOperatorLayer) →
  (Cshared : RHFormalization.CanonicalPrimePowerPackage) →
    (finiteCanonicalLimit : RHFormalization.DOperatorFiniteCanonicalLimitAtOverlapData finiteOperatorLayer Cshared) →
      (W : RHFormalization.DCanonicalWindowData) →
        RHFormalization.DCanonicalWindowAPI W →
          (F : RHFormalization.DFHLimitData finiteOperatorLayer.toStagePackage) →
            (sectors : RHFormalization.DResidualSectorData finiteOperatorLayer.toStagePackage) →
              (sectorSplit : RHFormalization.DResidualSectorSplitAPI finiteOperatorLayer.toStagePackage sectors) →
                (sectorBounds : RHFormalization.DResidualSectorBoundsAPI finiteOperatorLayer.toStagePackage sectors) →
                  (master : RHFormalization.DMasterResidualAPI finiteOperatorLayer.toStagePackage sectors) →
                    (have Bdata :=
                        RHFormalization.buildDBcanLimitDataFromOperatorFiniteCanonicalLimit finiteOperatorLayer Cshared
                          finiteCanonicalLimit;
                      have Rdata := master.h_master sectorSplit sectorBounds;
                      RHFormalization.DOverlapIdentityAPI finiteOperatorLayer.toStagePackage Bdata F Rdata) →
                      RHFormalization.DDetailedConstructionWithOperatorLegality :=
fun finiteOperatorLayer Cshared finiteCanonicalLimit W Wapi F sectors sectorSplit sectorBounds master overlapBuilder =>
  let Bdata :=
    RHFormalization.buildDBcanLimitDataFromOperatorFiniteCanonicalLimit finiteOperatorLayer Cshared
      finiteCanonicalLimit;
  { finiteOperatorLayer := finiteOperatorLayer, W := W, Wapi := Wapi, B := Bdata, F := F, sectors := sectors,
    sectorSplit := sectorSplit, sectorBounds := sectorBounds, master := master, overlapBuilder := overlapBuilder }
