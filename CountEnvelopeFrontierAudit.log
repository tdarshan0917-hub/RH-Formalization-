      self.soundMassCounting.weightData.weightEnvelope (self.alpha n).R ≤ self.weightBound n
  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.h_countBound_mul_weightBound_div_denominator_tendsto_zero : ∀
      s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0,
      Filter.Tendsto (fun n => self.countBound n * self.weightBound n / self.denominatorBound s n) Filter.atTop (nhds 0)
constructor:
  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.mk
    {X : RHFormalization.DFiniteStagePackageFromOperatorLayer} (W : RHFormalization.DCanonicalWindowData)
    (alpha : ℕ → RHFormalization.DFiniteStage) (Kshared : RHFormalization.CanonicalKernelC)
    (h_R_ge_nat : ∀ (n : ℕ), ↑n ≤ (alpha n).R)
    (h_indices_contains_of_center_le_R :
      ∀ (n : ℕ) (q : RHFormalization.PrimePowerPair),
        q.center ≤ (alpha n).R → q ∈ X.toFiniteCanonicalPrimePowerFormula.indices (alpha n))
    (h_indices_subset_center_le_R :
      ∀ (n : ℕ), ∀ q ∈ X.toFiniteCanonicalPrimePowerFormula.indices (alpha n), q.center ≤ (alpha n).R)
    (kernelMajorant : RHFormalization.PrimePowerPair → ℝ)
    (h_kernelMajorant_nonneg : ∀ (q : RHFormalization.PrimePowerPair), 0 ≤ kernelMajorant q)
    (kernelID : RHFormalization.PrimePowerDWindowKernelIdentificationData X W alpha Kshared) (coordSet : ℂ → Set ℝ)
    (h_coordSet_compact : ∀ s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0, IsCompact (coordSet s))
    (h_coord_mem :
      ∀ s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0,
        ∀ (n : ℕ), ∀ q ∈ X.toFiniteCanonicalPrimePowerFormula.indices (alpha n), kernelID.coord s q ∈ coordSet s)
    (windowSpeed : RHFormalization.DCanonicalWindowCompactSpeedAPI W alpha)
    (h_windowLimit_norm_le_majorant :
      ∀ s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0,
        ∀ (q : RHFormalization.PrimePowerPair), ‖W.G_limit (kernelID.coord s q)‖ ≤ kernelMajorant q)
    (summabilityEnvelope : RHFormalization.PrimePowerPair → ℝ)
    (h_weightedKernelMajorant_le_envelope :
      ∀ (q : RHFormalization.PrimePowerPair), ‖q.weightC‖ * kernelMajorant q ≤ summabilityEnvelope q)
    (h_summabilityEnvelope_summable : Summable summabilityEnvelope)
    (soundMassCounting : RHFormalization.PrimePowerSoundMassCountingSetWeightEnvelopeData)
    (denominatorBound : ℂ → ℕ → ℝ)
    (h_denominatorBound_pos :
      ∀ s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0, ∀ (n : ℕ), 0 < denominatorBound s n)
    (h_denominatorBound_le_windowSpeed :
      ∀ s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0,
        ∀ (n : ℕ), denominatorBound s n ≤ windowSpeed.speed (coordSet s) n)
    (countBound : ℕ → ℝ) (h_countBound_nonneg : ∀ (n : ℕ), 0 ≤ countBound n)
    (h_countEnvelope_le_countBound :
      ∀ (n : ℕ), soundMassCounting.centerCountingSet.countEnvelope (alpha n).R ≤ countBound n)
    (weightBound : ℕ → ℝ) (h_weightBound_nonneg : ∀ (n : ℕ), 0 ≤ weightBound n)
    (h_weightEnvelope_le_weightBound :
      ∀ (n : ℕ), soundMassCounting.weightData.weightEnvelope (alpha n).R ≤ weightBound n)
    (h_countBound_mul_weightBound_div_denominator_tendsto_zero :
      ∀ s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0,
        Filter.Tendsto (fun n => countBound n * weightBound n / denominatorBound s n) Filter.atTop (nhds 0)) :
    RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData X
