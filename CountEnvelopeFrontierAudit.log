      s ∈ RHFormalization.RightHalfPlane X.toStagePackage.sigma0,
      ∀ (q : RHFormalization.PrimePowerPair), ‖self.W.G_limit (self.kernelID.coord s q)‖ ≤ self.kernelMajorant q
