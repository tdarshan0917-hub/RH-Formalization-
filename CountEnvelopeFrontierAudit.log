  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.h_countEnvelope_le_countBound : ∀ (n : ℕ),
      self.soundMassCounting.centerCountingSet.countEnvelope (self.alpha n).R ≤ self.countBound n
  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.weightBound : ℕ → ℝ
  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.h_weightBound_nonneg : ∀ (n : ℕ),
