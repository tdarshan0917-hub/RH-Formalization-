      (q : RHFormalization.PrimePowerPair), ‖q.weightC‖ * self.kernelMajorant q ≤ self.summabilityEnvelope q
  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.h_summabilityEnvelope_summable : Summable
