structure RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData
  (X : RHFormalization.DFiniteStagePackageFromOperatorLayer) : Type 1
number of parameters: 1
fields:
  RHFormalization.CanonicalPrimePowerDWindowSoundCountingFactorBoundsData.W : RHFormalization.DCanonicalWindowData
