import RHFormalization.CanonicalPrimePowerTsumSeries

/-!
# RHFormalization.CanonicalPrimePowerConcreteTsumPackage

Concrete tsum-defined canonical prime-power package.

This is not an RH endpoint.

The previous layer reduced the D/H finite-to-limit burden to a tsum-level
series package with four fields:

* concrete finite index exhaustion;
* stage-kernel agreement on finite indices;
* summability of the shared prime-power kernel series;
* identification of `C.Bshared` with the corresponding `tsum`.

This file removes the last field by defining the shared canonical package
itself as that `tsum`.
-/

namespace RHFormalization

noncomputable section

open Complex Topology Filter
open scoped BigOperators

/--
The canonical prime-power package generated by a shared kernel and a convergence
half-plane.

Its shared function is definitionally the infinite prime-power kernel series.
-/
def canonicalPrimePowerPackageFromKernelTsum
    (sigma0 : ℝ)
    (Kshared : CanonicalKernelC) :
    CanonicalPrimePowerPackage :=
  { Bshared := fun s : ℂ =>
      ∑' q : PrimePowerPair,
        q.weightC * Kshared q.center s
    sigma0 := sigma0 }

/--
Concrete tsum-kernel data for the D-side shared canonical package.

Compared with `CanonicalPrimePowerTsumKernelSeriesData`, this no longer asks for

  `h_Bshared_eq_tsum`.

Instead, the shared package is definitionally

  `canonicalPrimePowerPackageFromKernelTsum X.toStagePackage.sigma0 Kshared`.
-/
structure CanonicalPrimePowerConcreteTsumKernelSeriesData
    (X : DFiniteStagePackageFromOperatorLayer) where
  alpha : ℕ → DFiniteStage

  /-- The common limiting kernel for the shared canonical prime-power series. -/
  Kshared : CanonicalKernelC

  /--
  Concrete finite-stage exhaustion: every prime-power index eventually appears
  in the finite stage index sets.
  -/
  h_indices_eventually_contains :
    ∀ q : PrimePowerPair,
      IsPrimePowerPair q →
      ∃ N : ℕ,
        ∀ n : ℕ,
          N ≤ n →
            q ∈ X.toFiniteCanonicalPrimePowerFormula.indices (alpha n)

  /--
  On each finite stage index set, the stage kernel agrees with the shared kernel.
  -/
  h_kernel_agrees_on_indices :
    ∀ n : ℕ,
    ∀ q : PrimePowerPair,
      q ∈ X.toFiniteCanonicalPrimePowerFormula.indices (alpha n) →
        ∀ s : ℂ,
          X.toFiniteCanonicalPrimePowerFormula.kernel (alpha n) q.center s =
            Kshared q.center s

  /--
  Summability of the infinite shared prime-power kernel series on the D overlap
  half-plane.
  -/
  h_summable :
    ∀ s : ℂ, s ∈ RightHalfPlane X.toStagePackage.sigma0 →
      Summable
        (fun q : PrimePowerPair => q.weightC * Kshared q.center s)

/--
Convert concrete tsum-kernel data into the previous tsum-level data.

The `h_Bshared_eq_tsum` field is discharged by `rfl`, because the canonical
package is defined as that `tsum`.
-/
def CanonicalPrimePowerConcreteTsumKernelSeriesData.toTsumKernelSeriesData
    {X : DFiniteStagePackageFromOperatorLayer}
    (S : CanonicalPrimePowerConcreteTsumKernelSeriesData X) :
    CanonicalPrimePowerTsumKernelSeriesData
      X
      (canonicalPrimePowerPackageFromKernelTsum
        X.toStagePackage.sigma0
        S.Kshared) :=
  { alpha := S.alpha
    h_Cshared_sigma_le := le_rfl
    Kshared := S.Kshared
    h_indices_eventually_contains := S.h_indices_eventually_contains
    h_kernel_agrees_on_indices := S.h_kernel_agrees_on_indices
    h_summable := S.h_summable
    h_Bshared_eq_tsum := by
      intro s hs
      rfl }

/--
Build `CanonicalPrimePowerExhaustionData` from concrete tsum-kernel data.
-/
def CanonicalPrimePowerConcreteTsumKernelSeriesData.toExhaustionData
    {X : DFiniteStagePackageFromOperatorLayer}
    (S : CanonicalPrimePowerConcreteTsumKernelSeriesData X) :
    CanonicalPrimePowerExhaustionData
      X
      (canonicalPrimePowerPackageFromKernelTsum
        X.toStagePackage.sigma0
        S.Kshared) :=
  S.toTsumKernelSeriesData.toExhaustionData

/--
Build `DBcanLimitData` directly from concrete tsum-kernel data.
-/
def buildDBcanLimitDataFromCanonicalPrimePowerConcreteTsumKernelSeries
    (X : DFiniteStagePackageFromOperatorLayer)
    (S : CanonicalPrimePowerConcreteTsumKernelSeriesData X) :
    DBcanLimitData X.toStagePackage :=
  buildDBcanLimitDataFromCanonicalPrimePowerTsumKernelSeries
    X
    (canonicalPrimePowerPackageFromKernelTsum
      X.toStagePackage.sigma0
      S.Kshared)
    S.toTsumKernelSeriesData

/--
The D-side canonical package matches the concrete tsum-defined shared package.
-/
theorem canonicalPrimePowerConcreteTsumKernelSeries_h_Bcan_matches_tsum
    (X : DFiniteStagePackageFromOperatorLayer)
    (S : CanonicalPrimePowerConcreteTsumKernelSeriesData X)
    (s : ℂ)
    (hs : s ∈ RightHalfPlane X.toStagePackage.sigma0) :
    (buildDBcanLimitDataFromCanonicalPrimePowerConcreteTsumKernelSeries X S).Bcan s =
      ∑' q : PrimePowerPair,
        q.weightC * S.Kshared q.center s := by
  simpa [canonicalPrimePowerPackageFromKernelTsum] using
    (buildDBcanLimitDataFromCanonicalPrimePowerConcreteTsumKernelSeries X S).h_Bcan_matches_shared
      s
      hs

end

end RHFormalization
