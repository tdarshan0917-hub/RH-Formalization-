def RHFormalization.canonicalPrimePowerPackageFromKernelTsum : ℝ →
  RHFormalization.CanonicalKernelC → RHFormalization.CanonicalPrimePowerPackage :=
fun sigma0 Kshared =>
  { Bshared := fun s => ∑' (q : RHFormalization.PrimePowerPair), q.weightC * Kshared q.center s, sigma0 := sigma0 }
@[reducible] def RHFormalization.HasPrincipalPartAtC : (ℂ → ℂ) → ℂ → ℂ → Prop :=
fun f z coeff => ∃ h, RHFormalization.HolomorphicAtC h z ∧ ∀ᶠ (w : ℂ) in nhds z, w ≠ z → f w = coeff / (w - z) + h w
