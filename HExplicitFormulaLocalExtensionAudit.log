RHFormalization.Harch_holomorphic_from_local_extensions (Y : RHFormalization.DDetailedConstructionWithOperatorLegality)
  (Zpole : ℂ → ℂ)
  (hlocal :
    ∀ z ∈ Ω,
      ∃ h,
        RHFormalization.HolomorphicAtC h z ∧
          RHFormalization.LocalEqAtC h (fun s => Y.B.Cshared.Bshared s + Zpole s) z) :
  RHFormalization.HolomorphicOnC (fun s => Y.B.Cshared.Bshared s + Zpole s) Ω
